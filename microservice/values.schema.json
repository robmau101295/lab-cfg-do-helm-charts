{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "container"
  ],
  "properties": {
    "environment": {
      "type": "string"
    },
    "container": {
      "type": "object",
      "required": [
        "image"
      ],
      "properties": {
        "image": {
          "type": "object",
          "required": [
            "registry",
            "tag"
          ],
          "properties": {
            "registry": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          }
        },
        "port": {
          "type": "integer"
        }
      }
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "envvars": {
      "type": "object",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "secrets": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "secretStoreName": {
          "type": "string"
        },
        "remoteKey": {
          "type": "string"
        },
        "refreshInterval": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer"
        },
        "loadBalancerSourceRanges": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9.]+/[0-9]+$"
          }
        },
        "annotations": {
          "type": "object"
        }
      }
    },
    "probes": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "readinessPath": {
          "type": "string"
        }
      }
    },
    "preStopSleepSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "podDisruptionBudget": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "spreadAcrossNodes": {
      "type": "boolean"
    }
  }
}
